# Application
APP_NAME=IQ-AI
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=*

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=/api/v1

# Docker Compose secrets (use long random values; keep passwords URL-safe)
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_PORT=80
IQAI_ADMIN_EMAIL=
IQAI_ADMIN_USERNAME=
IQAI_ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql+asyncpg://iqai_user:password@localhost:5432/iqai_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini (create a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_AUDIO_MODEL=gemini-2.5-flash-lite
GEMINI_REST_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=45
AI_AUDIO_MAX_SIZE_MB=10
AI_AUDIO_MAX_SECONDS=120

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,doc

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=
USE_S3=false

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@iq-ai.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
